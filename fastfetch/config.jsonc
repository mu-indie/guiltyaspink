{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/bess/.config/fastfetch/images/arch.txt",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "title",
        "break",
        {
            "type": "os",
            "key": "os    ",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "green"
        },
        {
            "type": "break"
        },
        {
            "type": "host",
            "format": "{vendor} {family}",
            "key": "host  ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "terminal",
            "keyColor": "red"
        },
        {
            "type": "break"
        },
        {
            "type": "cpu",
            "key": "cpu  ",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "cyan"
        },
        "break"
    ]
}