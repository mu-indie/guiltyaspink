{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/bess/.config/fastfetch/images/heart.txt",
    "padding": {
      "top": 1,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    "title",
    {
      "type": "os",
      "format": "Arch (btw)",
      "key": "os",
      "keyColor": "blue",
    },
    {
      "type": "host",
      "format": "HP OmniBook 5 Flip",
      "key": "host",
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "terminal",
      "keyColor": "blue",
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "blue",
    },
    {
      "type": "memory",
      "key": "memory",
      "keyColor": "blue",
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "blue",
    },
    {
      "type": "command",
      "key": "os age",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
  ],
}
